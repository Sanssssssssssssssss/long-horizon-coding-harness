# Keep automatic Skill evolution disabled for initial study runs.
SANS_AUTO_SKILL_EVOLUTION=0
PYTHONDONTWRITEBYTECODE=1

# Choose exactly one provider block and uncomment it.

# Anthropic official (do not set ANTHROPIC_BASE_URL for the official API).
# ANTHROPIC_API_KEY=replace-me
# MODEL=claude-sonnet-4-6

# OpenAI or an OpenAI-compatible endpoint. A non-empty base URL is required by
# this snapshot's provider routing logic.
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=your-model-name

# Anthropic-compatible proxy. The URL should contain /anthropic.
# APIKEY=replace-me
# API=https://your-host/anthropic
# MODEL=your-model-name
