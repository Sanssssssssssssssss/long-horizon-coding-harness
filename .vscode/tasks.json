{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sans: CLI",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "agents.main", "--thinking"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1", "PYTHONPYCACHEPREFIX": "${workspaceFolder}/experiment/cache/pycache", "SANS_AUTO_SKILL_EVOLUTION": "0", "SANS_SKILL_EVOLUTION_DIR": "${workspaceFolder}/experiment/runtime/skill-evolution"}},
      "presentation": {"reveal": "always", "focus": true, "panel": "dedicated"},
      "problemMatcher": []
    },
    {
      "label": "Sans: Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests", "-q", "--basetemp=experiment/cache/pytest/vscode-task-tests"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1", "PYTHONPYCACHEPREFIX": "${workspaceFolder}/experiment/cache/pycache"}},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Harness: Probe help",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-B", "-m", "benchmarks.probe", "--help"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
